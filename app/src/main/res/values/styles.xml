<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="TextAppearance.PlaylistMaker.Title"
        parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style
        name="TextAppearance.PlaylistMaker.Body"
        parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style
        name="TextAppearance.PlaylistMaker.Caption"
        parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style
        name="MainScreenButton"
        parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/screen_horizontal_margin</item>
        <item name="android:layout_marginEnd">@dimen/screen_horizontal_margin</item>
        <item name="android:backgroundTint">@color/YP_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="iconTint">@color/YP_black</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/main_button_icon_padding</item>
        <item name="cornerRadius">@dimen/main_button_corner_radius</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style
        name="SettingsItem"
        parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_item_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/screen_horizontal_margin</item>
        <item name="android:paddingEnd">@dimen/settings_icon_margin_end</item>
        <item name="android:textAppearance">@style/TextAppearance.PlaylistMaker.Body</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="drawableTint">@color/settings_icon</item>
    </style>

</resources>