<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/track_item_height">

    <ImageView
        android:id="@+id/trackArtwork"
        android:layout_width="@dimen/track_artwork_size"
        android:layout_height="@dimen/track_artwork_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/track_artwork_margin_start"
        android:layout_marginTop="@dimen/track_artwork_margin_top"
        app:srcCompat="@drawable/ic_track_placeholder"
        android:scaleType="center"
        />

    <TextView
        android:id="@+id/trackName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/trackArtwork"
        app:layout_constraintTop_toTopOf="@id/trackArtwork"
        app:layout_constraintEnd_toStartOf="@id/trackArrow"
        android:layout_marginStart="@dimen/track_name_margin_start"
        android:layout_marginTop="@dimen/track_name_margin_top"
        android:layout_marginEnd="@dimen/track_name_margin_end"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/track_name_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/primary_text"
        tools:text="Smells like tean spirit"
        />

    <ImageView
        android:id="@+id/trackArrow"
        android:layout_width="@dimen/track_arrow_size"
        android:layout_height="@dimen/track_arrow_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="@dimen/track_arrow_margin_end"
        app:srcCompat="@drawable/ic_arrow_right"
        app:tint="@color/track_info_color"
        />

    <TextView
        android:id="@+id/trackArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/trackName"
        app:layout_constraintTop_toBottomOf="@id/trackName"
        app:layout_constraintEnd_toStartOf="@id/trackSeparator"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constrainedWidth="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/track_info_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/track_info_color"
        tools:text="Nirvana"
        />

    <TextView
        android:id="@+id/trackTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@id/trackArtist"
        app:layout_constraintStart_toEndOf="@id/trackSeparator"
        app:layout_constraintEnd_toEndOf="@id/trackName"
        android:textSize="@dimen/track_info_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/track_info_color"
        tools:text="5:01"
        />

    <ImageView
        android:id="@+id/trackSeparator"
        android:layout_width="@dimen/track_separator_size"
        android:layout_height="@dimen/track_separator_size"
        android:scaleType="center"
        app:layout_constraintStart_toEndOf="@id/trackArtist"
        app:layout_constraintTop_toTopOf="@id/trackArtist"
        app:layout_constraintBottom_toBottomOf="@id/trackArtist"
        app:layout_constraintEnd_toStartOf="@id/trackTime"
        app:srcCompat="@drawable/ic_track_separator"
        app:tint="@color/track_info_color"
        />


</androidx.constraintlayout.widget.ConstraintLayout>